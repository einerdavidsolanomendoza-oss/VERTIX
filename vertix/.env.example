# Copia este archivo como .env.local y rellena los valores para desarrollo local.
# En Vercel, crea estas mismas claves en Project Settings > Environment Variables,
# seleccionando Production (y Preview si quieres que funcione en deployed previews).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY
